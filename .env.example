# 홈서버 앱 컨테이너용. 실제 .env는 저장소 밖에 보관한다.
DB_URL=jdbc:postgresql://postgres:5432/family_share
DB_USERNAME=familyshare
DB_PASSWORD=change-me
TOSS_APP_NAME=salim-link
# base64 로 인코딩한 32바이트 이상: head -c32 /dev/urandom | base64
JWT_SECRET_BASE64=
SPRING_PROFILES_ACTIVE=toss-mtls
# 컨테이너 안 경로. 호스트 인증서 폴더는 배포 스크립트가 /certs에 읽기 전용 연결한다.
TOSS_MTLS_CERTIFICATE=file:/certs/toss.crt
TOSS_MTLS_PRIVATE_KEY=file:/certs/toss.key
SLACK_WEBHOOK_URL=
# 알림 템플릿 코드(카피 리뷰 승인 후). 비우면 알림을 보내지 않는다.
ALERT_TEMPLATE_SET_CODE=
