# docker compose 용 환경변수. 이 파일을 .env 로 복사해 채운다. .env 는 저장소에 넣지 않는다.
MYSQL_ROOT_PASSWORD=change-me-root
DB_USERNAME=familyshare
DB_PASSWORD=change-me
TOSS_APP_NAME=salim-link
# base64 로 인코딩한 32바이트 이상: head -c32 /dev/urandom | base64
JWT_SECRET_BASE64=
# mTLS 인증서(toss.crt, toss.key)가 들어 있는 폴더. 저장소 밖에 둔다.
MTLS_DIR=/home/app/certs
# 알림 템플릿 코드(카피 리뷰 승인 후). 비우면 알림을 보내지 않는다.
ALERT_TEMPLATE_SET_CODE=
